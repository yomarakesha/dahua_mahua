###############################################################################
# Kanagatly VMS backend — environment for a NATIVE (non-Docker) install.
#
#   cp backend/.env.example backend/.env
#   # then set JWT_SECRET, NVR_SECRET_KEY, BOOTSTRAP_ADMIN_PASSWORD
#
# start.ps1 / start-mac.sh auto-generate backend/.env with random secrets on a
# fresh box, so you only need this file when installing/configuring by hand.
# Anything left commented falls back to the code default in app/settings.py.
###############################################################################

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (zero-install) by default. For prod use Postgres:
#   DATABASE_URL=postgresql+asyncpg://dss:dss@localhost:5432/dss
DATABASE_URL=sqlite+aiosqlite:///./dss.db

# ── Security (REQUIRED in production — the app refuses to boot on defaults) ───
# JWT signing key. Anything random and >= 32 bytes.  Generate:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=replace-with-a-long-random-hex-string

# Fernet key for at-rest encryption of NVR passwords. MUST be a 32-byte
# url-safe base64 string.  Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NVR_SECRET_KEY=replace-with-fernet-key

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# Used ONLY when the user table is empty on first startup (or by
# `python -m app.create_admin`). The admin is forced to change this password on
# first login (must_change_password=True), so pick anything the installer knows.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# ── Playback timezone ────────────────────────────────────────────────────────
# UTC offset (MINUTES east of UTC) of the NVR's internal clock, used to map
# recording timestamps to wall time. 0 = UTC. Turkmenistan/UTC+5 = 300.
# The effective value is logged loudly at startup.
PLAYBACK_TZ_OFFSET_MINUTES=0

# ── go2rtc WebRTC candidates (fullscreen main) ───────────────────────────────
# The server's VIEWER-FACING LAN IP(s) advertised as WebRTC ICE candidates.
# LEAVE EMPTY to auto-detect this box's primary private-LAN IPv4 (recommended
# for a single-NIC server). On a MULTI-NIC box (e.g. a separate camera network)
# auto-detect may pick the wrong interface — set it explicitly, comma-separated
# host:port:
#   GO2RTC_WEBRTC_CANDIDATES=10.0.0.5:8556,192.168.1.20:8556
GO2RTC_WEBRTC_CANDIDATES=

# ── Relay / ports (defaults are fine for a standard install) ─────────────────
# RELAY=go2rtc            # go2rtc buffered-MSE relay (default; the React UI needs it)
# Ports served by the launcher / Caddy TLS front:
#   8443  UI + API (HTTPS, what the desktop app connects to)
#   8556  go2rtc WebRTC (fullscreen main)
#   1984  go2rtc API (localhost)
#   8000  backend (uvicorn, behind the TLS front)
