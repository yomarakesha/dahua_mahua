# Kanagatly VMS ingress — ONE secure origin so the browser gets a secure context
# (required for WebCodecs) with no mixed-content / CORS. The React SPA derives all
# its endpoints from the page origin (web-react/src/lib/config.ts), so everything
# is same-origin and path-routed here:
#
#   /api/*      → backend  (path kept → FastAPI sees /api/v1/… ; api_prefix)
#   /readyz     → backend  (liveness/readiness; used by the install script)
#   /healthz    → backend
#   /go2rtc/*   → go2rtc    (prefix STRIPPED → /api/ws?src=… ; MSE/WebRTC signalling)
#   everything else → the built SPA (web-react/dist, baked into this image)
#
# `tls internal` mints a self-signed cert (Caddy's local CA) so :8443 is HTTPS
# with zero config — the desktop client trusts it explicitly. WebSocket upgrades
# (go2rtc MSE + the playback API WS) are handled automatically by reverse_proxy.
#
# Upstreams are env-overridable so a Linux host-networking override can point at
# the host gateway instead of the compose DNS name (see docker-compose + README).
{
	admin off
	# Self-signed certs have no ACME/OCSP; keep Caddy fully offline.
	auto_https disable_redirects
}

:{$CADDY_HTTPS_PORT:8443} {
	tls internal

	# Backend API + health/readiness (path preserved).
	@backend path /api/* /readyz /healthz /health
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	# go2rtc signalling/WS — strip the /go2rtc prefix so go2rtc sees /api/ws?src=…
	handle_path /go2rtc/* {
		reverse_proxy {$GO2RTC_UPSTREAM:go2rtc:1984}
	}

	# Static SPA (hash-routed; try_files keeps deep links working regardless).
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}
